# 浏览器可使用的 Supabase 公共配置
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 服务端配置（绝不能加 VITE_ 前缀，也不能提交真实值）
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
APP_ORIGIN=https://YOUR_APP.onrender.com

# 第一次正式迁移时，替换成你的 Supabase auth.users UUID
MIGRATION_OWNER_ID=00000000-0000-4000-8000-000000000001
